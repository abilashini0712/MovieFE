@page "/ticket/{BookingId:int}" 
@using MovieTicketBookingSystem.Models
@inject HttpClient Http

<div class="ticket-wrapper">
<MudPaper >

    <MudCard Class="ticket-container">
        <div class="ticket-div">

        @foreach (var ticket in tickets)
    {
        <MudText>Date:@ticket.Date </MudText>
        <MudText>Time:@ticket.Time </MudText>
        <MudText>Cinemas:@ticket.Cinemas </MudText>
        <MudText>Seats:@ticket.Seats  </MudText>
    }
        </div>

        <div class="message">
            <MudText> Enjoy your movie   </MudText>
                <MudText> Thank you for booking with us! </MudText>
        </div>

    </MudCard>

</MudPaper>

</div>

<style>

    .ticket-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 90vh;
        background-color: #000000;
        padding: 20px;
    }


    .ticket-container{
        width: 100%;
        max-width: 420px;
        background-color: #121212 !important;
        border: 1px solid #D4A017;
        border-radius: 10px;
        padding: 40px 30px;
        box-shadow: 0 0 20px rgba(212, 160, 23, 0.15);
    }

   .ticket-div{
        color: goldenrod !important;
   }

   .message{
       color:white !important ;
       align-items: center;
        margin-top: 25px;
        border-top: 1px solid #333;
        padding-top: 20px;
   }

</style>
@code {

  

    [Parameter]
    public int BookingId { get; set; }

  

       private List<TicketModel> tickets = new();

    
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
           
            tickets = await Http.GetFromJsonAsync<List<TicketModel>>(
                            $"https://localhost:7218/api/Ticket/{BookingId}"
            ) ?? new List<TicketModel>();

            
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load tickets: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

}
