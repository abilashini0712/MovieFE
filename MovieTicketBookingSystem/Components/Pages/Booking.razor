<div class="booking-page">

    <MudPaper Class="booking-dashboard" Elevation="0">

        <MudForm @ref="form" @bind-IsValid="isValid">

            <div class="booking-header">
                <MudText Class="brand-title">CINEMATIX</MudText>
                <MudText Class="header-subtitle">MOVIE TICKET BOOKING</MudText>
            </div>

            <div class="booking-layout">

                @* LEFT SIDE - MOVIE AND BOOKING DETAILS *@

                <div class="movie-booking-panel">

                    <MudText Class="panel-heading">
                        Movie Details
                    </MudText>

                    <div class="movie-information">

                        @if (!string.IsNullOrWhiteSpace(MovieImage))
                        {
                            <MudImage Src="@MovieImage"
                                      Class="booking-movie-poster"
                                      ObjectFit="ObjectFit.Cover" />
                        }
                        else
                        {
                            <div class="poster-placeholder">
                                <MudIcon Icon="@Icons.Material.Filled.Movie"
                                         Size="Size.Large" />
                                No Poster
                            </div>
                        }

                        <div class="movie-information-details">

                            <MudText Class="booking-movie-title">
                                @MovieName
                            </MudText>

                            <MudText Class="movie-subtitle">
                                Select your preferred show and seats
                            </MudText>

                            <MudText Class="movie-rating">
                                <MudIcon Icon="@Icons.Material.Filled.LocalMovies"
                                         Size="Size.Small" />
                                Cinema Experience
                            </MudText>

                        </div>

                    </div>

                    <MudDivider Class="booking-divider" />

                    @* DATE *@

                    <MudText Class="section-label">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth"
                                 Size="Size.Small" />
                        Select Date
                    </MudText>

                    <div class="booking-input">
                        <MudDatePicker Label="Booking Date"
                                       Date="@Date"
                                       DateChanged="@OnDateChanged"
                                       Variant="Variant.Outlined"
                                       Required="true"
                                       MinDate="@DateTime.Today" />
                    </div>

                    @* TIME *@

                    <MudText Class="section-label">
                        <MudIcon Icon="@Icons.Material.Filled.AccessTime"
                                 Size="Size.Small" />
                        Select Showtime
                    </MudText>

                    <div class="time-options">

                        <MudButton Class="@GetTimeClass("morning")"
                                   OnClick="@(() => OnTimeChanged("morning"))">
                            10:30 AM
                        </MudButton>

                        <MudButton Class="@GetTimeClass("afternoon")"
                                   OnClick="@(() => OnTimeChanged("afternoon"))">
                            02:00 PM
                        </MudButton>

                        <MudButton Class="@GetTimeClass("evening")"
                                   OnClick="@(() => OnTimeChanged("evening"))">
                            06:30 PM
                        </MudButton>

                        <MudButton Class="@GetTimeClass("night")"
                                   OnClick="@(() => OnTimeChanged("night"))">
                            09:30 PM
                        </MudButton>

                    </div>

                    @* CINEMA *@

                    <MudText Class="section-label">
                        <MudIcon Icon="@Icons.Material.Filled.LocationOn"
                                 Size="Size.Small" />
                        Select Cinema
                    </MudText>

                    <div class="booking-input">

                        <MudSelect T="string"
                                   Label="Cinema"
                                   Value="@cinemas"
                                   ValueChanged="@OnCinemaChanged"
                                   Variant="Variant.Outlined"
                                   Required="true">

                            <MudSelectItem T="string" Value="@("C1")">
                                Cinema C1
                            </MudSelectItem>

                            <MudSelectItem T="string" Value="@("C2")">
                                Cinema C2
                            </MudSelectItem>

                            <MudSelectItem T="string" Value="@("C3")">
                                Cinema C3
                            </MudSelectItem>

                        </MudSelect>

                    </div>

                    @* NUMBER OF TICKETS *@

                    <MudText Class="section-label">
                        Number of Tickets
                    </MudText>

                    <div class="booking-input">

                        <MudNumericField T="int"
                                         Label="Tickets"
                                         @bind-Value="Tickets"
                                         Min="1"
                                         Max="30"
                                         Variant="Variant.Outlined"
                                         Required="true" />

                    </div>

                    <MudDivider Class="booking-divider" />

                    @* SELECTED SEATS *@

                    <MudText Class="section-label">
                        <MudIcon Icon="@Icons.Material.Filled.EventSeat"
                                 Size="Size.Small" />
                        Selected Seats
                    </MudText>

                    <div class="selected-seats">

                        @if (selectedSeats.Count == 0)
                        {
                            <MudText Class="empty-seats">
                                No seats selected yet
                            </MudText>
                        }
                        else
                        {
                            @foreach (var seat in selectedSeats.OrderBy(s => s))
                            {
                                <span class="selected-seat-chip">
                                    @seat
                                </span>
                            }
                        }

                    </div>

                    <div class="booking-summary">

                        <div class="summary-row">
                            <span>Selected Tickets</span>
                            <strong>@selectedSeats.Count</strong>
                        </div>

                        <div class="summary-row">
                            <span>Movie</span>
                            <strong>@MovieName</strong>
                        </div>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-3">
                            @errorMessage
                        </MudAlert>
                    }

                    <MudButton OnClick="Payment"
                               Class="pay-btn"
                               FullWidth="true"
                               Disabled="@(isProcessing ||
                                   isLoadingSeats ||
                                   !availabilityLoaded)">

                        @if (isProcessing)
                        {
                            <MudProgressCircular Indeterminate="true"
                                                 Size="Size.Small"
                                                 Class="mr-2" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Payment"
                                     Class="mr-2" />
                            <span>Proceed To Payment</span>
                        }

                    </MudButton>

                </div>


                @* RIGHT SIDE - SEAT SELECTION *@

                <div class="seat-booking-panel">

                    <MudText Class="panel-heading">
                        Select Your Seats
                    </MudText>

                    <div class="screen-container">
                        <div class="screen-curve"></div>
                        <MudText Class="screen-text">SCREEN</MudText>
                    </div>

                    @if (isLoadingSeats)
                    {
                        <div class="seat-message">

                            <MudProgressCircular Indeterminate="true"
                                                 Color="Color.Info" />

                            <MudText>Loading seat availability...</MudText>

                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(seatError))
                    {
                        <MudAlert Severity="Severity.Error">
                            @seatError
                        </MudAlert>
                    }
                    else if (!availabilityLoaded)
                    {
                        <div class="seat-message">
                            <MudIcon Icon="@Icons.Material.Filled.EventSeat"
                                     Size="Size.Large" />

                            <MudText>
                                Select a date, time and cinema to view available seats.
                            </MudText>
                        </div>
                    }
                    else
                    {
                        <div class="seat-map">

                            @foreach (var row in allSeats.GroupBy(s => s[0]))
                            {
                                <div class="seat-row">

                                    <span class="row-label">
                                        @row.Key
                                    </span>

                                    <div class="seat-items">

                                        @foreach (var seat in row)
                                        {
                                            var isReserved = reservedSeats.Contains(seat);

                                            <MudButton @key="seat"
                                                       Class="@GetSeatClass(seat)"
                                                       Variant="Variant.Filled"
                                                       Size="Size.Small"
                                                       Disabled="@isReserved"
                                                       OnClick="@(() => ToggleSeat(seat))">

                                                @seat.Substring(1)

                                            </MudButton>
                                        }

                                    </div>

                                    <span class="row-label">
                                        @row.Key
                                    </span>

                                </div>
                            }

                        </div>
                    }

                    @* SEAT LEGEND *@

                    <div class="seat-legend">

                        <div>
                            <span class="legend-box selected"></span>
                            Selected
                        </div>

                        <div>
                            <span class="legend-box available"></span>
                            Available
                        </div>

                        <div>
                            <span class="legend-box reserved"></span>
                            Booked
                        </div>

                    </div>

                    <div class="seat-count">
                        @selectedSeats.Count / @Tickets Seats Selected
                    </div>

                </div>

            </div>

        </MudForm>

    </MudPaper>

</div>




@code {
    private MudForm? form;
    private bool isValid;


    public DateTime? Date { get; set; } = DateTime.Today;

    public string Time { get; set; } = string.Empty;

    public string cinemas { get; set; } = string.Empty;

    public int Tickets { get; set; }

    public string Seats { get; set; } = string.Empty;

    [Parameter]
    public int RegisterId { get; set; }

    [SupplyParameterFromQuery(Name = "movieName")]
    public string MovieName { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "movieImage")]
public string MovieImage { get; set; } = string.Empty;

    
    private readonly List<string> allSeats = Enumerable
        .Range(1, 5)
        .SelectMany(row => Enumerable.Range(1, 10)
            .Select(number =>
                $"{(char)('A' + row - 1)}{number}"))
        .ToList();

    private HashSet<string> reservedSeats = new(
        StringComparer.OrdinalIgnoreCase);

    private HashSet<string> selectedSeats = new(
        StringComparer.OrdinalIgnoreCase);

    private bool isLoadingSeats;
    private bool availabilityLoaded;
    private bool isProcessing;

    private string seatError = string.Empty;
    private string errorMessage = string.Empty;

  
    private string GetSeatClass(string seat)
    {
        if (reservedSeats.Contains(seat))
        {
            return "seat-button reserved-seat";
        }

        if (selectedSeats.Contains(seat))
        {
            return "seat-button selected-seat";
        }

        return "seat-button available-seat";
    }

    private void ToggleSeat(string seat)
    {
        if (!availabilityLoaded ||
            isLoadingSeats ||
            reservedSeats.Contains(seat))
        {
            return;
        }

        errorMessage = string.Empty;

        if (selectedSeats.Contains(seat))
        {
            selectedSeats.Remove(seat);
        }
        else
        {
            selectedSeats.Add(seat);
        }
    }

  
    private async Task LoadReservedSeats()
    {
        selectedSeats.Clear();
        reservedSeats.Clear();

        availabilityLoaded = false;
        seatError = string.Empty;
        errorMessage = string.Empty;

        if (Date == null ||
            string.IsNullOrWhiteSpace(Time) ||
            string.IsNullOrWhiteSpace(cinemas) ||
            string.IsNullOrWhiteSpace(MovieName))
        {
            return;
        }

        isLoadingSeats = true;

        try
        {
            var date = Date.Value.ToString(
                "yyyy-MM-dd",
                CultureInfo.InvariantCulture);

            var url =
                "https://localhost:7218/api/Booking/available-seats" +
                $"?date={date}" +
                $"&time={Uri.EscapeDataString(Time)}" +
                $"&cinema={Uri.EscapeDataString(cinemas)}" +
                $"&movieName={Uri.EscapeDataString(MovieName.Trim())}";

            using var response = await Http.GetAsync(url);

            if (!response.IsSuccessStatusCode)
            {
                seatError =
                    "Could not load seat availability. Please try again.";

                return;
            }

            var result = await response.Content
                .ReadFromJsonAsync<List<string>>();

            reservedSeats = new HashSet<string>(
                result ?? new List<string>(),
                StringComparer.OrdinalIgnoreCase);

            availabilityLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Error loading reserved seats: {ex.Message}");

            seatError =
                "Could not connect to the booking server. " +
                "Please try again.";
        }
        finally
        {
            isLoadingSeats = false;
        }
    }

 
    private async Task OnDateChanged(DateTime? value)
    {
        Date = value;
        await LoadReservedSeats();
    }

    private async Task OnTimeChanged(string value)
    {
        Time = value;
        await LoadReservedSeats();
    }

    private async Task OnCinemaChanged(string value)
    {
        cinemas = value;
        await LoadReservedSeats();
    }

    private async Task OnMovieNameChanged(string value)
    {
        MovieName = value;
        await LoadReservedSeats();
    }

    
private string GetTimeClass(string time)
{
    return Time == time
        ? "time-btn time-active"
        : "time-btn";
}


    private async Task Payment()
    {
        if (form == null || isProcessing)
        {
            return;
        }

        if (isLoadingSeats || !availabilityLoaded)
        {
            errorMessage =
                "Please load seat availability before continuing.";
            return;
        }

        try
        {
            isProcessing = true;
            errorMessage = string.Empty;

            await form.Validate();

            if (!form.IsValid)
            {
                return;
            }

            if (Date == null)
            {
                errorMessage = "Please select a booking date.";
                return;
            }

            if (Tickets <= 0)
            {
                errorMessage =
                    "Number of tickets must be greater than zero.";
                return;
            }

            if (selectedSeats.Count != Tickets)
            {
                errorMessage =
                    "The number of selected seats must equal " +
                    "the number of tickets.";
                return;
            }

            if (selectedSeats.Any(
                seat => reservedSeats.Contains(seat)))
            {
                errorMessage =
                    "One or more selected seats are already reserved.";
                return;
            }

            Seats = string.Join(
                ",",
                selectedSeats.OrderBy(s => s));

            var bookingData = new
            {
                Seats = Seats,
                Time = Time,
                Cinemas = cinemas,
                Date = Date.Value.ToString(
                    "yyyy-MM-dd",
                    CultureInfo.InvariantCulture),
                Tickets = Tickets,
                RegisterId = RegisterId,
                MovieName = MovieName.Trim(),
                // MovieImage = MovieImage.Trim()
            };

            using var response = await Http.PostAsJsonAsync(
                "https://localhost:7218/api/Booking",
                bookingData);

            if (response.IsSuccessStatusCode)
            {
                var booking = await response.Content
                    .ReadFromJsonAsync<BookingResponse>();

                if (booking != null && booking.Id > 0)
                {
                    Navigation.NavigateTo(
                        $"/payment/{booking.Id}");
                }
                else
                {
                    errorMessage =
                        "Booking saved, but no valid booking ID was returned.";
                }
            }
            else if ((int)response.StatusCode == 409)
            {
                errorMessage =
                    "Some seats were just booked by another user. " +
                    "Please select your seats again.";

                await LoadReservedSeats();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();

                Console.WriteLine(
                    $"Booking failed: {(int)response.StatusCode} - {error}");

                errorMessage =
                    "Booking failed. Please check your details and try again.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Error saving booking: {ex.Message}");

            errorMessage =
                "An error occurred while processing your booking.";
        }
        finally
        {
            isProcessing = false;
        }
    }

    public class BookingResponse
    {
        public int Id { get; set; }
    }
}


