@page "/payment/{BookingId:int}"

@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization

@inject HttpClient Http
@inject NavigationManager Navigation

@attribute [Authorize]

<MudPaper Class="payment-card" Elevation="4">
    <MudText Typo="Typo.h5" Class="payment-title">
        Secure Payment
    </MudText>

    <MudText Class="payment-field">
        Your card details will be entered securely
        on Stripe Checkout.
    </MudText>

    <MudButton OnClick="Pay"
               Disabled="@isLoading"
               FullWidth="true"
               Class="pay-btn">
        @(isLoading ? "Redirecting..." : "Pay with Stripe")
    </MudButton>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">
            @errorMessage
        </MudAlert>
    }
</MudPaper>

@code {
    [Parameter]
    public int BookingId { get; set; }

    private bool isLoading;
    private string errorMessage = string.Empty;

    private async Task Pay()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var response = await Http.PostAsJsonAsync(
                "https://localhost:7218/api/Payment/create-checkout-session",
                new { BookingId });

            // if (!response.IsSuccessStatusCode)
            // {
            //     errorMessage =
            //         "Unable to start payment. Please try again.";
            //     return;
            // }

            if (!response.IsSuccessStatusCode)
{
    var error = await response.Content.ReadAsStringAsync();

    errorMessage =
        $"Payment failed ({(int)response.StatusCode}): {error}";

    Console.WriteLine(errorMessage);
    return;
}

            var result = await response.Content
                .ReadFromJsonAsync<CheckoutResponse>();

            if (string.IsNullOrWhiteSpace(result?.checkoutUrl))
            {
                errorMessage = "Stripe did not return a checkout URL.";
                return;
            }

            Navigation.NavigateTo(result.checkoutUrl, forceLoad: true);
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to connect to the payment server.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private sealed class CheckoutResponse
    {
        public string checkoutUrl { get; set; } = string.Empty;
    }
}

<style>
