<MudContainer Class="cinematic-wrapper" MaxWidth="MaxWidth.False">

    @if (CurrentMovie != null)
    {
        <div class="hero-banner">

            @* Background and movie details *@
            <div class="hero-slide" @key="CurrentMovie.Title">

                <div class="hero-backdrop"
                     style="@($"background-image: url('{CurrentMovie.Poster}')")">
                </div>

                <div class="hero-overlay"></div>

                <div class="hero-content">

                    <MudStack Spacing="2" Class="hero-details">

                        <MudText Class="hero-label">
                            NOW SHOWING
                        </MudText>

                        <MudText Class="hero-heading">
                            @CurrentMovie.Title
                        </MudText>

                        <MudText Class="hero-meta">
                            @CurrentMovie.Year
                            <span> • </span>
                            @CurrentMovie.Duration
                        </MudText>

                        <MudText Class="hero-description">
                            @CurrentMovie.Description
                        </MudText>

                        <MudText Class="hero-cinema">
                            <MudIcon Icon="@Icons.Material.Filled.LocationOn"
                                     Size="Size.Small" />
                            @CurrentMovie.Cinema
                        </MudText>

                       @*  <div class="hero-actions">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Default"
                                       Class="hero-book-btn"
                                       StartIcon="@Icons.Material.Filled.PlayCircle"
                                       Onclick="bookTicket">
                                Book Tickets
                            </MudButton>
                        </div> *@

                    </MudStack>

                </div>

            </div>

            @* Previous button *@
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                           Class="hero-arrow hero-prev"
                           OnClick="PreviousMovie" />

            @* Next button *@
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                           Class="hero-arrow hero-next"
                           OnClick="NextMovie" />

            @* Carousel indicators *@
            <div class="hero-indicators">

                @for (int i = 0; i < Movies.Count; i++)
                {
                    int index = i;

                    <button class="hero-dot @(CurrentIndex == index ? "active" : "")"
                            @onclick="() => GoToMovie(index)">
                    </button>
                }

            </div>

        </div>
    }

</MudContainer>



<MudContainer Class="now-showing-wrapper" MaxWidth="MaxWidth.False">

    <MudPaper Class="section-header" Elevation="0">
        <MudText Typo="Typo.h5" Class="section-title">
            Now Showing
        </MudText>
    </MudPaper>

    <div class="movie-grid">

        @foreach (var movie in Movies)
        {
            <MudPaper Class="grid-card" Elevation="0">

                <MudImage Src="@movie.Poster"
                          Class="poster"
                          ObjectFit="ObjectFit.Cover" />

                <div class="movie-info">
                    <MudText Class="movie-name">
                        @movie.Title
                    </MudText>

                    <MudText Class="movie-meta">
                        @movie.Year &bull; @movie.Duration
                    </MudText>
                </div>

            </MudPaper>
        }

    </div>

</MudContainer>


