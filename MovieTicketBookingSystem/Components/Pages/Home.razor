    //             });
    //         },
    //         null,
    //         TimeSpan.FromSeconds(5),
    //         TimeSpan.FromSeconds(5)
    //     );
    // }



    protected override void OnInitialized()
    {
        movieTimer = new System.Threading.Timer(
            async _ =>
            {
                await InvokeAsync(() =>
                {
                    if (Movies.Count == 0)
                        return;

                    CurrentIndex = (CurrentIndex + 1) % Movies.Count;

                    StateHasChanged();
                });
            },
            null,
            TimeSpan.FromSeconds(5),
            TimeSpan.FromSeconds(5)
        );
    }

    // Previous movie
    private void PreviousMovie()
    {
        if (Movies.Count == 0)
            return;

        CurrentIndex = (CurrentIndex - 1 + Movies.Count) % Movies.Count;
    }

    // Next movie
    private void NextMovie()
    {
        if (Movies.Count == 0)
            return;

        CurrentIndex = (CurrentIndex + 1) % Movies.Count;
    }

    // Select a particular movie using indicators
    private void GoToMovie(int index)
    {
        if (index < 0 || index >= Movies.Count)
            return;

        CurrentIndex = index;
    }


    public void Dispose()
    {
        movieTimer?.Dispose();
    }

