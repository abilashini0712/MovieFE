@page "/ticket/{BookingId:int}"

@using System.Net.Http.Json
@using MovieTicketBookingSystem.Models
@using QRCoder
@using Microsoft.AspNetCore.Components
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>My Movie Tickets</PageTitle>

<div class="ticket-wrapper">

    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true"
                             Color="Color.Warning" />
        <MudText Color="Color.Warning">
            Loading your tickets...
        </MudText>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Warning">
            @errorMessage
        </MudAlert>
    }
    else if (tickets.Count > 0)
    {
        <div class="ticket-list">

            @foreach (var ticket in tickets)
            {
                <MudPaper Class="ticket-container"
                          Elevation="4"
                          @key="ticket.Id">

                    <div class="ticket-header">
                        <MudText Typo="Typo.h5">
                            MOVIE TICKET
                        </MudText>
                        <MudText Typo="Typo.body2">
                            Booking ID: @ticket.BookingId
                        </MudText>
                    </div>

                    <MudDivider />

                    <div class="ticket-details">

                        <MudText Typo="Typo.h6">
                            @ticket.MovieName
                        </MudText>

                        <MudText Typo="Typo.body2">
                            <b>Date &amp; Time</b>
                        </MudText>

                        <MudText>
                            @ticket.Date.ToString("dd MMM yyyy")
                        </MudText>

                        <MudText>
                            @ticket.Time
                        </MudText>

                        <MudText Typo="Typo.body2">
                            <b>Cinema</b>
                        </MudText>

                        <MudText>
                            @ticket.Cinemas
                        </MudText>

                        <MudText Typo="Typo.body2">
                            <b>Seat Number</b>
                        </MudText>

                        <MudText Typo="Typo.h6">
                            @ticket.Seats
                        </MudText>

                        <MudText Typo="Typo.body2">
                            <b>Ticket ID</b>
                        </MudText>

                        <MudText>
                            @ticket.Id
                        </MudText>

                    </div>

                    <div class="qr-section">

                        @if (qrImages.TryGetValue(
                            ticket.Id, out var qrImage))
                        {
                            <img src="@qrImage"
                                 alt="QR code for ticket @ticket.Id"
                                 class="qr-image" />
                        }

                        <MudText Typo="Typo.caption">
                            Scan to verify this ticket
                        </MudText>

                    </div>

                    <MudDivider />

                    <div class="ticket-footer">
                        <MudText>
                            Enjoy your movie!
                        </MudText>

                        <MudText Typo="Typo.caption">
                            Keep this ticket for entry.
                        </MudText>
                    </div>

                </MudPaper>
            }

           @*  <MudButton Variant="Variant.Filled"
                       Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.Print"
                       OnClick="PrintTickets">
                Download / Print Tickets
            </MudButton> *@

        </div>
    }
</div>

<style>
    .ticket-wrapper {
        min-height: 90vh;
        padding: 24px 12px;
        background: #000;
        display: flex;
        justify-content: center;
        align-items: flex-start;
    }

    .ticket-list {
        width: 100%;
        max-width: 440px;
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .ticket-container {
        width: 100%;
        padding: 28px 24px;
        background: #121212 !important;
        color: white;
        border: 1px solid #D4A017;
        border-radius: 14px;
        box-sizing: border-box;
    }

    .ticket-header {
        text-align: center;
        color: #D4A017;
        margin-bottom: 16px;
    }

    .ticket-details {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding-top: 18px;
    }

        .ticket-details b {
            color: #D4A017;
        }

    .qr-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 24px 0;
        margin-top: 18px;
        border-top: 1px dashed #D4A017;
        border-bottom: 1px dashed #D4A017;
    }

    .qr-image {
        width: 180px;
        height: 180px;
        background: white;
        padding: 8px;
        object-fit: contain;
    }

    .ticket-footer {
        text-align: center;
        padding-top: 16px;
        color: #D4A017;
    }

    @@media print {
        .ticket-wrapper {
            background: white !important;
            padding: 0;
        }

        .ticket-list {
            max-width: none;
            gap: 0;
        }

        .ticket-container {
            background: white !important;
            color: black !important;
            border: 1px solid black;
            box-shadow: none;
            break-after: page;
        }

        .ticket-list > button {
            display: none !important;
        }
    }
</style>

@code {
    [Parameter]
    public int BookingId { get; set; }

    private List<TicketModel> tickets = new();

    private Dictionary<int, string> qrImages = new();

    private bool isLoading = true;

    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetAsync(
                $"https://localhost:7218/api/Ticket/{BookingId}");

            if (response.IsSuccessStatusCode)
            {
                tickets = await response.Content
                    .ReadFromJsonAsync<List<TicketModel>>()
                    ?? new List<TicketModel>();

                if (tickets.Count == 0)
                {
                    errorMessage =
                        "No tickets were found for this booking.";
                    return;
                }

                foreach (var ticket in tickets)
                {
                    qrImages[ticket.Id] =
                        GenerateQrImage(ticket.QrToken);
                }
            }
            else if (response.StatusCode ==
                     System.Net.HttpStatusCode.NotFound)
            {
                errorMessage =
                    "Tickets are not available yet. " +
                    "Please check your payment status.";
            }
            else
            {
                errorMessage =
                    $"Unable to load tickets. " +
                    $"Status: {(int)response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            errorMessage =
                "Could not connect to the ticket server.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GenerateQrImage(string token)
    {
        using var generator = new QRCodeGenerator();

        using var data = generator.CreateQrCode(
            token,
            QRCodeGenerator.ECCLevel.Q);

        var qrCode = new PngByteQRCode(data);

        byte[] bytes = qrCode.GetGraphic(20);

        return "data:image/png;base64," +
               Convert.ToBase64String(bytes);
    }

    private async Task PrintTickets()
    {
        await JS.InvokeVoidAsync("print");
    }
}
