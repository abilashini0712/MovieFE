@page "/contact"
@inject NavigationManager Navigation
@inject HttpClient Http
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="login-wrapper">
    <MudPaper Class="contact-container">
        <MudForm @ref="form"  Class="form">

            <MudText Typo="Typo.h5" Class="head">We Are Here To Help You</MudText>

            <MudTextField T="string" Label="Name" @bind-Value="contact.Name"
                          Class="contact-field" Required="true" MaxLength="100" />

            <MudTextField T="string" Label="Email" @bind-Value="contact.Email"
                           Class="contact-field"  Validation="@(new EmailAddressAttribute().IsValid(contact.Email) ? null : "Enter a valid email address.")"
                          MaxLength="254" 
                          Required="true" />

            <MudTextField T="string" Label="Subject" @bind-Value="contact.Subject"
                          Class="contact-field"  MaxLength="150" Required="true"/>

            <MudTextField T="string" Label="Message" @bind-Value="contact.Message"
                          Lines="4" Class="contact-field" Required="true" MaxLength="3000" />

            <MudButton Variant="Variant.Filled"
                       Class="send-btn"
                       Disabled="@isSending"
                       OnClick="SubmitContact"
                       FullWidth="true">
                @(isSending ? "Sending..." : "Send Message")
            </MudButton>

        </MudForm>

      @if (!string.IsNullOrWhiteSpace(status))
            {
                <MudAlert Severity="@severity" Class="mt-4">
                    @status
                </MudAlert>
            }

        <div class="contact-info">
            <MudText Class="address">Kandy, Sri Lanka</MudText>
            <MudText Class="phone">+91 98765 43210</MudText>
            <MudText Class="email">support@cineworldmultiplex.com</MudText>
        </div>
    </MudPaper>
</div>

<style>
    .login-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 90vh;
        background-color: #000000;
        padding: 20px;
    }

    .contact-container {
        width: 100%;
        max-width: 460px;
        margin: 0 auto;
        padding: 40px 30px;
        background-color: #121212 !important;
        border: 1px solid #D4A017;
        border-radius: 10px;
        box-shadow: 0 0 20px rgba(212, 160, 23, 0.15);
        text-align: center;
    }

    .head {
        color: #D4A017;
        font-weight: 700;
        margin-bottom: 25px;
        letter-spacing: 0.5px;
    }

    .form {
        width: 100%;
        display: flex;
        flex-direction: column;
    }

    .contact-field {
        margin-bottom: 20px;
        text-align: left;
    }

        .contact-field .mud-input-label {
            color: #d9d9d9 !important;
        }

        .contact-field .mud-input-slot {
            color: #ffffff !important;
        }

        .contact-field .mud-input:before,
        .contact-field .mud-input:after {
            border-color: #D4A017 !important;
        }

        .contact-field .mud-input-outlined-border {
            border-color: #555555 !important;
        }

        .contact-field:hover .mud-input-outlined-border {
            border-color: #D4A017 !important;
        }

        .contact-field.mud-input-focused .mud-input-outlined-border {
            border-color: #D4A017 !important;
        }

    .send-btn {
        margin-top: 12px;
        background-color: #D4A017 !important;
        color: #000000 !important;
        font-weight: 700;
        border-radius: 8px;
        transition: background-color 0.2s ease, transform 0.15s ease;
    }

        .send-btn:hover {
            background-color: #b8890f !important;
            transform: translateY(-1px);
        }

    .contact-info {
        margin-top: 25px;
        border-top: 1px solid #333;
        padding-top: 20px;
    }

    .address,
    .phone,
    .email {
        color: #D4A017;
        margin-bottom: 6px;
    }

   

    @@media (max-width: 600px) {
        .contact-container {
            padding: 30px 20px;
        }

        .head {
            font-size: 1.2rem;
        }
    }

    @@media (max-width: 400px) {
        .login-wrapper {
            padding: 10px;
        }

        .contact-container {
            border-radius: 6px;
        }
    }
</style>

@code {
    private MudForm? form;
    private bool isSending;
    private string status = "";
    private Severity severity = Severity.Info;

    private ContactInput contact = new();

    private async Task SubmitContact()
{
    if (form is null || isSending)
        return;

    await form.Validate();

    if (!form.IsValid)
        return;

    isSending = true;
    status = "";

    try
    {
        var response = await Http.PostAsJsonAsync(
            "https://localhost:7218/api/Contact",
            contact);

        if (response.IsSuccessStatusCode)
        {
            status = "Your message has been sent successfully!";
            severity = Severity.Success;

            contact = new ContactInput();
            await form.ResetAsync();
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();

            status = $"Error {(int)response.StatusCode}: {error}";
            severity = Severity.Error;
        }
    }
    catch (HttpRequestException ex)
    {
        status = $"Connection error: {ex.Message}";
        severity = Severity.Error;
    }
    finally
    {
        isSending = false;
    }
}
    public class ContactInput
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Subject { get; set; } = "";
        public string Message { get; set; } = "";
    }

    public string Name { get; set; } = string.Empty;
    public string Email { get; set; } = string.Empty;
    public string Subject { get; set; } = string.Empty;
    public string Message { get; set; } = string.Empty;

}
