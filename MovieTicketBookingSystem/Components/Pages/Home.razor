/* CINEMATIC HERO SECTION */

.cinematic-wrapper {
    padding: 0 !important;
    margin: 0 !important;
    max-width: 100% !important;
    background-color: #080808;
}

.hero-banner {
    position: relative;
    width: 100%;
    height: 560px;
    min-height: 500px;
    overflow: hidden;
    background: #080808;
}

/* BACKGROUND IMAGE */

.hero-slide {
    position: absolute;
    inset: 0;
    overflow: hidden;
    animation: heroFade 1s ease;
}

.hero-backdrop {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 30%;
    background-repeat: no-repeat;
    animation: heroZoom 6s ease forwards;
}

/* DARK GRADIENT OVERLAY */

.hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        90deg,
        rgba(5, 5, 12, 0.98) 0%,
        rgba(5, 5, 12, 0.85) 28%,
        rgba(5, 5, 12, 0.45) 55%,
        rgba(5, 5, 12, 0.08) 100%
    );
}

/* MOVIE DETAILS */

.hero-content {
    position: absolute;
    left: 5%;
    bottom: 95px;
    width: 480px;
    max-width: 85%;
    color: white;
    z-index: 2;
}

.hero-details {
    gap: 12px;
}

.hero-label {
    color: goldenrod;
    font-size: 0.9rem;
    font-weight: bold;
    letter-spacing: 3px;
}

.hero-heading {
    color: white;
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1.2;
}

.hero-meta {
    color: #eeeeee;
    font-size: 0.95rem;
    font-weight: 500;
}

.hero-description {
    color: #dddddd;
    font-size: 1rem;
    line-height: 1.7;
    max-width: 450px;
}

.hero-cinema {
    display: flex;
    align-items: center;
    gap: 5px;
    color: #d6d6d6;
    font-size: 0.85rem;
}

/* BOOK BUTTON */

.hero-actions {
    margin-top: 12px;
}

.hero-book-btn {
    background-color: white !important;
    color: black !important;
    border-radius: 30px !important;
    padding: 10px 25px !important;
    font-weight: bold !important;
    transition: all 0.3s ease;
}

.hero-book-btn:hover {
    background-color: goldenrod !important;
    transform: scale(1.05);
}

/* LEFT AND RIGHT ARROWS */

.hero-arrow {
    position: absolute !important;
    top: 48%;
    z-index: 5;
    color: white !important;
    background-color: rgba(80, 80, 80, 0.55) !important;
    width: 45px !important;
    height: 55px !important;
    transition: all 0.3s ease;
}

.hero-arrow:hover {
    background-color: goldenrod !important;
    color: black !important;
}

.hero-prev {
    left: 15px;
}

.hero-next {
    right: 15px;
}

/* BOTTOM INDICATORS */

.hero-indicators {
    position: absolute;
    bottom: 25px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 5;
}

.hero-dot {
    width: 22px;
    height: 4px;
    border: none;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.45);
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
}

.hero-dot.active {
    width: 45px;
    background-color: white;
}

/* TRANSITIONS */

@@keyframes heroFade {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

@@keyframes heroZoom {
    from {
        transform: scale(1.08);
    }

    to {
        transform: scale(1);
    }
}

/* RESPONSIVE DESIGN */

@@media (max-width: 900px) {

    .hero-banner {
        height: 500px;
    }

    .hero-content {
        left: 5%;
        width: 430px;
    }

    .hero-heading {
        font-size: 2.1rem;
    }

}

@@media (max-width: 600px) {

    .hero-banner {
        height: 530px;
        min-height: 530px;
    }

    .hero-backdrop {
        background-position: center;
    }

    .hero-overlay {
        background: linear-gradient(
            0deg,
            rgba(5, 5, 12, 0.98) 0%,
            rgba(5, 5, 12, 0.80) 50%,
            rgba(5, 5, 12, 0.15) 100%
        );
    }

    .hero-content {
        left: 6%;
        bottom: 75px;
        width: 88%;
        max-width: 88%;
    }

    .hero-heading {
        font-size: 1.8rem;
    }

    .hero-description {
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .hero-arrow {
        top: 40%;
        width: 35px !important;
        height: 45px !important;
    }

    .hero-prev {
        left: 5px;
    }

    .hero-next {
        right: 5px;
    }

}




    /* MOVIE POSTER ANIMATION */

    .movie-image {
        flex-shrink: 0;
        animation: posterAnimation 1s ease;
    }

    .movie {
        width: 250px;
        height: 400px;
        box-shadow: 0 0 15px goldenrod;
        border-radius: 4px;
    }

    @@keyframes posterAnimation {
        from {
            opacity: 0;
            transform: translateX(-80px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* MOVIE DETAILS ANIMATION */

    .details {
        gap: 20px;
        width: 580px;
        color: white;
        font-family: 'Times New Roman', Times, serif;
        margin-top: 40px;
        margin-left: 40px;

        animation: detailsAnimation 1s ease;
    }

    @@keyframes detailsAnimation {
        from {
            opacity: 0;
            transform: translateX(80px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .movie-title {
        margin: 0;
        font-size: 2rem;
        color: white;
    }

    .movie-desc {
        border: 1px solid goldenrod;
        box-shadow: 0 0 5px goldenrod;
        padding: 15px 20px;
        line-height: 1.5;
        background-color: transparent;
        color: white;
    }

    .line {
        width: 100%;
        color: white;
        background-color: #151615;
        box-shadow: 0 0 5px goldenrod;
        padding: 15px;
        box-sizing: border-box;
        font-weight: bold;
    }

    /* NOW SHOWING SECTION */

    .now-showing-wrapper {
        background-color: black;
        padding: 30px 60px;
    }

    .section-header {
        border: 1px solid goldenrod;
        background-color: black;
        padding: 20px 25px;
        margin-bottom: 30px;
    }

    .section-title {
        color: white;
        font-weight: bold;
    }

    .movie-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 30px;
    }

    .grid-card {
        background-color: #0d0d0d;
        border-radius: 4px;
        overflow: hidden;
    }

    .poster {
        width: 100%;
        height: 420px;
        display: block;
    }

    .movie-info {
        padding: 12px 15px 18px;
    }

    .movie-name {
        color: goldenrod;
        font-family: 'Times New Roman', Times, serif;
        font-weight: bold;
        font-size: 1.1rem;
    }

    .movie-meta {
        color: #bbbbbb;
        font-size: 0.85rem;
        margin-top: 4px;
    }

    @@media (max-width: 900px) {
        .movie-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .hero-card {
            gap: 25px;
            padding: 30px;
        }
    }

    @@media (max-width: 600px) {
        .hero-card {
            flex-direction: column;
            align-items: center !important;
        }

        .details {
            width: 100%;
            margin: 20px 0;
        }

        .movie {
            width: 220px;
            height: 330px;
        }

        .now-showing-wrapper {
            padding: 20px;
        }

        .movie-grid {
            grid-template-columns: 1fr;
        }
    }

</style>


@code {

    private int CurrentIndex = 0;

    private Movie? CurrentMovie =>
        Movies.Count > 0 ? Movies[CurrentIndex] : null;

    private System.Threading.Timer? movieTimer;

    // protected override void OnInitialized()
    // {
    //     movieTimer = new System.Threading.Timer(
    //         async _ =>
    //         {
    //             await InvokeAsync(() =>
    //             {
