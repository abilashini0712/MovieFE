private async Task Payment()
{
    if (form == null || isProcessing)
        return;

    try
    {
        isProcessing = true;

        await form.Validate();

        if (!form.IsValid)
            return;

        if (Date == null)
        {
            Console.WriteLine("Please select a booking date.");
            return;
        }

        if (Tickets <= 0)
        {
            Console.WriteLine("Number of tickets must be greater than zero.");
            return;
        }

        SelectSeats();

        if (string.IsNullOrWhiteSpace(Seats))
        {
            Console.WriteLine("Please select at least one seat.");
            return;
        }

        var selectedSeatList = Seats.Split(
            ',',
            StringSplitOptions.RemoveEmptyEntries);

        if (selectedSeatList.Length != Tickets)
        {
            Console.WriteLine(
                "The number of selected seats must equal the number of tickets.");
            return;
        }

       

       if (Date == null)
{
    Console.WriteLine("Please select a booking date.");
    return;
}

var selectedDate = Date.Value;

Console.WriteLine(
    $"Selected date in frontend: {selectedDate:yyyy-MM-dd}");

    Console.WriteLine($"Movie name received: '{MovieName}'");

var bookingData = new
{
    Seats = Seats,
    Time = Time,
    Cinemas = cinemas,
    Date = selectedDate.ToString("yyyy-MM-dd"),
    Tickets = Tickets,
    RegisterId = RegisterId,
    MovieName = MovieName
};

       
        var response = await Http.PostAsJsonAsync(
            "https://localhost:7218/api/Booking",
            bookingData);

        if (response.IsSuccessStatusCode)
        {
            var booking = await response.Content
                .ReadFromJsonAsync<BookingResponse>();

            if (booking != null && booking.Id > 0)
            {
             
                Navigation.NavigateTo($"/payment/{booking.Id}");
            }
            else
            {
                Console.WriteLine(
                    "Booking was saved, but no valid booking ID was returned.");
            }
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();

            Console.WriteLine(
                $"Booking failed: {(int)response.StatusCode} - {error}");
        }
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Error saving booking: {ex.Message}");
    }
    finally
    {
        isProcessing = false;
    }
}

public class BookingResponse
{
    public int Id { get; set; }
}


    

