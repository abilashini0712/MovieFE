@page "/addMovies"
@inject NavigationManager Navigation
@inject HttpClient Http

<MudPaper Class="pa-4 add-movie-card">

    <MudText Typo="Typo.h5" Class="add-movie-title">Add New Movie</MudText>

    <MudForm @ref="form" @bind-IsValid="@isValid">

        <MudTextField T="string"
                      Label="Movie Name"
                      @bind-Value="Title"
                      Required="true" />

        <MudTextField T="string"
                      Label="Genre"
                      @bind-Value="Gener"
                      Required="true" />

        <MudTextField T="string"
                      Label="Duration"
                      @bind-Value="Duration"
                      Required="true" />

        <MudFileUpload T="IBrowserFile"
                       FilesChanged="UploadFiles"
                       Accept="image/*">

            <ActivatorContent>
                <MudButton Variant="Variant.Filled" Class="gold-outline-btn">
                    Upload Image
                </MudButton>
            </ActivatorContent>

        </MudFileUpload>

        @if (PosterFile != null)
        {
            <MudText Class="selected-image">
                Selected Image: @PosterFile.Name
            </MudText>
        }

        <MudButton Variant="Variant.Filled"
                   Class="gold-btn"
                   OnClick="AddMovie">
            Add Movie
        </MudButton>

    </MudForm>

</MudPaper>

<style>

    
    .add-movie-card {
        background-color: #000000 !important;
        border: 1px solid goldenrod;
        border-radius: 12px;
        max-width: 600px;
        margin: 40px auto;
        padding: 30px !important;
        box-sizing: border-box;
        box-shadow: 0 0 20px rgba(218, 165, 32, 0.25);
    }

    /* ---------- Page title ---------- */
    .add-movie-title {
        color: gold !important;
        font-weight: bold !important;
        text-align: center;
        margin-bottom: 20px;
    }

    .add-movie-card .mud-input,
    .add-movie-card .mud-input-slot {
        color: white !important;
    }

    .add-movie-card .mud-input-label {
        color: goldenrod !important;
    }

    .add-movie-card .mud-input-control:focus-within .mud-input-label {
        color: gold !important;
    }

    .add-movie-card .mud-input.mud-input-underline:before {
        border-bottom: 1px solid goldenrod !important;
    }

    .add-movie-card .mud-input.mud-input-underline:after {
        border-bottom: 2px solid gold !important;
    }

    .add-movie-card input:-webkit-autofill {
        -webkit-box-shadow: 0 0 0 1000px #000000 inset !important;
        -webkit-text-fill-color: white !important;
    }

    .gold-outline-btn {
        background-color: #000000 !important;
        color: gold !important;
        border: 1px solid gold !important;
        border-radius: 8px !important;
        font-weight: bold !important;
        margin-top: 20px;
    }

        .gold-outline-btn:hover {
            background-color: rgba(255, 215, 0, 0.15) !important;
        }

    .selected-image {
        color: white !important;
        margin-top: 10px;
    }

    .gold-btn {
        background-color: gold !important;
        color: #000000 !important;
        font-weight: bold !important;
        border-radius: 8px !important;
        width: 100%;
        margin-top: 25px;
        padding: 10px !important;
    }

        .gold-btn:hover {
            background-color: darkgoldenrod !important;
        }

    @@media (max-width: 600px) {
        .add-movie-card {
            margin: 20px 15px;
            padding: 20px !important;
        }
    }

</style>

@code {

    private MudForm? form;
    private bool isValid;

    private string Title { get; set; } = string.Empty;
    private string Gener { get; set; } = string.Empty;
    private string Duration { get; set; } = string.Empty;

    private IBrowserFile? PosterFile;
    private byte[]? image;

    private async Task UploadFiles(IBrowserFile file)
    {
        PosterFile = file;

        using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);

        using var memoryStream = new MemoryStream();

        await stream.CopyToAsync(memoryStream);

        image = memoryStream.ToArray();
    }

    private async Task AddMovie()
    {
        await form!.Validate();

        if (!form.IsValid)
            return;

        if (image == null || image.Length == 0)
        {
            Console.WriteLine("Please select an image.");
            return;
        }

        var MovieData = new
        {
            title = Title,
            duration = Duration,
            gener = Gener,
            image = image
        };

        var response = await Http.PostAsJsonAsync(
            "https://localhost:7218/api/Cards",
            MovieData
        );

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/movie");
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();

            Console.WriteLine($"Movie Added failed: {response.StatusCode}");
            Console.WriteLine(error);
        }

       

    }
}