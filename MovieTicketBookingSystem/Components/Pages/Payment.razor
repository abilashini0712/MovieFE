@page "/payment/{BookingId:int}"
@inject HttpClient Http
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]


<div class="login-wrapper">
    <MudPaper Class="payment-card">
        <MudForm @ref="form">
            <MudText Class="payment-title">Payment Details</MudText>

            <MudTextField T="string" Label="Cardholder Name" @bind-Value="name" Class="payment-field" Required="true" />

           
            <MudTextField T="string"
                          Label="Card Number"
                          @bind-Value="number"
                          Class="payment-field"
                          Required="true"
                          MaxLength="CardNumberLength"
                          Immediate="true"
                          Validation="@((Func<string, string?>)ValidateCardNumber)" />

          

           <MudTextField T="string"
              Label="Expiry Date (MM/YY)"
              @bind-Value="date"
              Class="payment-field"
              Required="true"
              Mask="@(new PatternMask("00/00"))"
              Placeholder="MM/YY"
              Validation="ValidateExpiryDate" />

           
            <MudTextField T="string"
                          Label="CVV"
                          @bind-Value="cvv"
                          Class="payment-field"
                          Required="true"
                          MaxLength="CvvLength"
                          Immediate="true"
                          Validation="@((Func<string, string?>)ValidateCvv)" />

            <MudButton OnClick="pay" Class="pay-btn" FullWidth="true">
                Pay
            </MudButton>
        </MudForm>
    </MudPaper>
</div>

<style>
    .login-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 90vh;
        background-color: #000000;
        padding: 20px;
    }

    .payment-card {
        width: 100%;
        max-width: 420px;
        background-color: #121212 !important;
        border: 1px solid #D4A017;
        border-radius: 10px;
        padding: 40px 30px;
        box-shadow: 0 0 20px rgba(212, 160, 23, 0.15);
    }

    .payment-title {
        color: #D4A017;
        font-size: 1.6rem;
        font-weight: 700;
        text-align: center;
        margin-bottom: 30px;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .payment-field {
        margin-bottom: 22px;
    }

        .payment-field .mud-input-label {
            color: #d9d9d9 !important;
        }

        .payment-field .mud-input-slot {
            color: #ffffff !important;
        }

        .payment-field .mud-input:before,
        .payment-field .mud-input:after {
            border-color: #D4A017 !important;
        }

        .payment-field .mud-input-outlined-border {
            border-color: #555555 !important;
        }

        .payment-field:hover .mud-input-outlined-border {
            border-color: #D4A017 !important;
        }

        .payment-field.mud-input-focused .mud-input-outlined-border {
            border-color: #D4A017 !important;
        }

    .pay-btn {
        background-color: #D4A017 !important;
        color: #000000 !important;
        font-weight: 700;
        letter-spacing: 0.5px;
        margin-top: 10px;
        border-radius: 6px;
        transition: background-color 0.2s ease, transform 0.15s ease;
    }

        .pay-btn:hover {
            background-color: #b8890f !important;
            transform: translateY(-1px);
        }



    @@media (max-width: 600px) {
        .payment-card {
            padding: 30px 20px;
            max-width: 100%;
        }

        .payment-title {
            font-size: 1.3rem;
        }
    }

    @@media (max-width: 400px) {
        .login-wrapper {
            padding: 10px;
        }

        .payment-card {
            border-radius: 6px;
        }
    }
</style>

@code {
    private MudForm? form;


    private const int CardNumberLength = 16;
    private const int CvvLength = 3;

    public class PaymentResponse
    {
        public int? id { get; set; }
        public string name { get; set; }
        public string number { get; set; }
        public string date { get; set; }
        public int? cvv { get; set; }
    }


    private string? ValidateCardNumber(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "Card number is required.";

        if (!value.All(char.IsDigit))
            return "Card number must contain only digits.";

        if (value.Length != CardNumberLength)
            return $"Card number must contain exactly {CardNumberLength} digits.";

        return null; 
    }

    private string? ValidateExpiryDate(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        return "Expiry date is required.";

        if (!System.Text.RegularExpressions.Regex.IsMatch(
                value, @"^(0[1-9]|1[0-2])/\d{2}$"))
            return "Enter a valid date in MM/YY format.";

        var parts = value.Split('/');
        int month = int.Parse(parts[0]);
        int year = 2000 + int.Parse(parts[1]);

        var today = DateTime.Today;
        var expiry = new DateTime(year, month, 1);

        if (expiry < new DateTime(today.Year, today.Month, 1))
            return "Card has expired.";

        return null;
    }

    
    private string? ValidateCvv(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "CVV is required.";

        if (!value.All(char.IsDigit))
            return "CVV must contain only digits.";

        if (value.Length != CvvLength)
            return $"CVV must contain exactly {CvvLength} digits.";

        return null;
    }

    [Parameter]
    public int BookingId { get; set; }

    private async Task pay()
    {
        await form.Validate();

        if (form.IsValid)
        {
            var paymentData = new
            {
                name = name,
                number = number,
                date = date,
                cvv = cvv,
                BookingId = BookingId
            };

            var response = await Http.PostAsJsonAsync(
                "https://localhost:7218/api/Payment",
                paymentData);

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo($"/ticket/{BookingId}");
            }
        }
    }

    public string name { get; set; } = string.Empty;
    public string number { get; set; } = string.Empty;
    public string date { get; set; } = string.Empty;
    public string cvv { get; set; } = string.Empty; 
}
