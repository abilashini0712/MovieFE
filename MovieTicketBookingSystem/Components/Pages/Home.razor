
@page "/"
@implements IDisposable

<MudContainer Class="page-wrapper" MaxWidth="MaxWidth.False">

    @if (CurrentMovie != null)
    {
        <MudStack Row="true" Class="hero-card"
                  AlignItems="AlignItems.Start" Spacing="0">

            <div class="movie-image">
                <MudImage Src="@CurrentMovie.Poster"
                          Class="movie"
                          ObjectFit="ObjectFit.Cover" />
            </div>

            <MudStack Class="details" Spacing="0">

                <MudText Typo="Typo.h1" Class="movie-title">
                    @CurrentMovie.Title
                </MudText>

                <MudPaper Class="movie-desc" Elevation="0">
                    <MudText>
                        @CurrentMovie.Description
                    </MudText>
                </MudPaper>

                <MudPaper Class="line" Elevation="0">
                    <MudText>
                        @CurrentMovie.Cinema
                    </MudText>
                </MudPaper>

            </MudStack>

        </MudStack>
    }

</MudContainer>


<MudContainer Class="now-showing-wrapper" MaxWidth="MaxWidth.False">

    <MudPaper Class="section-header" Elevation="0">
        <MudText Typo="Typo.h5" Class="section-title">
            Now Showing
        </MudText>
    </MudPaper>

    <div class="movie-grid">

        @foreach (var movie in Movies)
        {
            <MudPaper Class="grid-card" Elevation="0">

                <MudImage Src="@movie.Poster"
                          Class="poster"
                          ObjectFit="ObjectFit.Cover" />

                <div class="movie-info">
                    <MudText Class="movie-name">
                        @movie.Title
                    </MudText>

                    <MudText Class="movie-meta">
                        @movie.Year &bull; @movie.Duration
                    </MudText>
                </div>

            </MudPaper>
        }

    </div>

</MudContainer>


<style>

    /* HERO SECTION */

    .page-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 90vh;
        background-color: black;
        overflow: hidden;
    }

    .hero-card {
        gap: 50px;
        padding: 60px;
        width: 100%;
        max-width: 1100px;
    }

    /* MOVIE POSTER ANIMATION */

    .movie-image {
        flex-shrink: 0;
        animation: posterAnimation 1s ease;
    }

    .movie {
        width: 250px;
        height: 400px;
        box-shadow: 0 0 15px goldenrod;
        border-radius: 4px;
    }

    @@keyframes posterAnimation {
        from {
            opacity: 0;
            transform: translateX(-80px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* MOVIE DETAILS ANIMATION */

    .details {
        gap: 20px;
        width: 580px;
        color: white;
        font-family: 'Times New Roman', Times, serif;
        margin-top: 40px;
        margin-left: 40px;

        animation: detailsAnimation 1s ease;
    }

    @@keyframes detailsAnimation {
        from {
            opacity: 0;
            transform: translateX(80px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .movie-title {
        margin: 0;
        font-size: 2rem;
        color: white;
    }

    .movie-desc {
        border: 1px solid goldenrod;
        box-shadow: 0 0 5px goldenrod;
        padding: 15px 20px;
        line-height: 1.5;
        background-color: transparent;
        color: white;
    }

    .line {
        width: 100%;
        color: white;
        background-color: #151615;
        box-shadow: 0 0 5px goldenrod;
        padding: 15px;
        box-sizing: border-box;
        font-weight: bold;
    }

    /* NOW SHOWING SECTION */

    .now-showing-wrapper {
        background-color: black;
        padding: 30px 60px;
    }

    .section-header {
        border: 1px solid goldenrod;
        background-color: black;
        padding: 20px 25px;
        margin-bottom: 30px;
    }

    .section-title {
        color: white;
        font-weight: bold;
    }

    .movie-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 30px;
    }

    .grid-card {
        background-color: #0d0d0d;
        border-radius: 4px;
        overflow: hidden;
    }

    .poster {
        width: 100%;
        height: 420px;
        display: block;
    }

    .movie-info {
        padding: 12px 15px 18px;
    }

    .movie-name {
        color: goldenrod;
        font-family: 'Times New Roman', Times, serif;
        font-weight: bold;
        font-size: 1.1rem;
    }

    .movie-meta {
        color: #bbbbbb;
        font-size: 0.85rem;
        margin-top: 4px;
    }

    @@media (max-width: 900px) {
        .movie-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .hero-card {
            gap: 25px;
            padding: 30px;
        }
    }

    @@media (max-width: 600px) {
        .hero-card {
            flex-direction: column;
            align-items: center !important;
        }

        .details {
            width: 100%;
            margin: 20px 0;
        }

        .movie {
            width: 220px;
            height: 330px;
        }

        .now-showing-wrapper {
            padding: 20px;
        }

        .movie-grid {
            grid-template-columns: 1fr;
        }
    }

</style>


@code {

    private int CurrentIndex = 0;

    private Movie? CurrentMovie =>
        Movies.Count > 0 ? Movies[CurrentIndex] : null;

    private System.Threading.Timer? movieTimer;

    protected override void OnInitialized()
    {
        movieTimer = new System.Threading.Timer(
            async _ =>
            {
                await InvokeAsync(() =>
                {
                    CurrentIndex = (CurrentIndex + 1) % Movies.Count;

                    StateHasChanged();
                });
            },
            null,
            TimeSpan.FromSeconds(5),
            TimeSpan.FromSeconds(5)
        );
    }

    public void Dispose()
    {
        movieTimer?.Dispose();
    }

    private List<Movie> Movies = new()
    {
        new Movie
