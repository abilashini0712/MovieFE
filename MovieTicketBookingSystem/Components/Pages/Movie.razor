@page "/movie"
@using MovieTicketBookingSystem.Models
@inject HttpClient Http

<MudPaper Class="section">
    <MudText Typo="Typo.h5" Class="title"> Now Showing </MudText>
</MudPaper>

<MudGrid Class="card-container">

   
    @if (isLoading)
    {
        <MudText Class="title">Loading movies...</MudText>
    }
    else if (movies.Count == 0)
    {
        <MudText Class="title">No movies found.</MudText>
    }
    else
    {
        
        @foreach (var movie in movies)
        {
            <MudItem xs="12" sm="6" md="3">
                <MovieCard image="@GetImageSrc(movie)"
                           title="@movie.title"
                           gener="@movie.gener"
                           duration="@movie.duration" />
            </MudItem>
        }
    }

</MudGrid>


<MudPaper Class="section">
    <MudText Typo="Typo.h5" Class="title"> Upcomming Movies </MudText>
</MudPaper>

<MudGrid Class="card-container">
    <MudItem xs="12" sm="6" md="3">
        <MovieCard uimage="/images/jurassic.jpg"
                   utitle="Jurassic World"
                   ugener="Science Fiction"
                   uduration="Comming Soon" />
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MovieCard uimage="/images/parasakthi.jpg"
                   utitle="Parasakthi"
                   ugener="Polticals"
                   uduration="Comming Soon" />
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MovieCard uimage="/images/bison.jpg"
                   utitle="Bison"
                   ugener="Sports Drama"
                   uduration="Comming Soon" />
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MovieCard uimage="/images/zoot.jpg"
                   utitle="Zootophia"
                   ugener="Animation"
                   uduration="Comming Soon" />
    </MudItem>
</MudGrid>


<style>

    .section {
        border: 1px solid goldenrod;
        background-color: black;
        padding: 20px 30px;
        margin-bottom: 30px;
        width: 100%;
        max-width: 1600px;
        margin-left: auto;
        margin-right: auto;
        box-sizing: border-box;
        display: flex;
    }

    .title {
        color: white;
        font-weight: bold;
    }

    .card-container {
        display: grid !important;
        grid-template-columns: repeat(4, 1fr) !important;
        gap: 24px !important;
        max-width: 1600px;
        margin: 0 auto 40px auto !important;
        padding: 0 30px;
        box-sizing: border-box;
    }

        .card-container > div {
            width: 100% !important;
            max-width: 100% !important;
            flex-basis: auto !important;
            box-sizing: border-box;
        }

    @@media (max-width: 900px) {
        .card-container {
            grid-template-columns: repeat(2, 1fr) !important;
        }
    }

    @@media (max-width: 600px) {
        .card-container {
            grid-template-columns: 1fr !important;
            padding: 0 15px;
        }
    }

</style>

@code {

  
    private List<MovieModel> movies = new();

    
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
           
            movies = await Http.GetFromJsonAsync<List<MovieModel>>(
                "https://localhost:7218/api/Cards"
            ) ?? new List<MovieModel>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load movies: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    
    private string GetImageSrc(MovieModel movie)
    {
        if (movie.Image == null || movie.Image.Length == 0)
            return string.Empty; 

        return $"data:image/jpeg;base64,{Convert.ToBase64String(movie.Image)}";
    }
}