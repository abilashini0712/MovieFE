@page "/cinemas"

<MudContainer Class="cinema-container">
    <MudCardMedia Image="@image" Class="cinema-image" />

    <div class="cinema-content">
        <MudText class="c1">@cinema</MudText>
        <MudText class="para">
            @paragraph1
        </MudText>
        <MudText Class="para2">
            @paragraph2
        </MudText>

        <MudList T="string" class="features">
            <MudListItem> @list1</MudListItem>
            <MudListItem> @list2</MudListItem>
            <MudListItem> @list3</MudListItem>
        </MudList>
    </div>
</MudContainer>

<style>
    
    .cinema-container {
        display: flex;
        align-items: flex-start; 
        background-color: #000000;
        padding: 60px;
        gap: 60px;
        flex-wrap: wrap; 
    }

    .cinema-image {
        flex: 1 1 45%;
        min-width: 300px;
        width: 100%;
        height: 500px;
        object-fit: cover;
        border-radius: 8px;
    }

    .cinema-content {
        flex: 1 1 45%;
        min-width: 300px;
        display: flex;
        flex-direction: column;
    }

    .c1 {
        color: #D4A017;
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        margin-bottom: 20px;
        text-transform: uppercase;
    }


    .para,
    .para2 {
        color: #d9d9d9;
        font-size: 1rem;
        line-height: 1.7;
        margin-bottom: 20px;
    }

    .features {
        margin-top: 20px;
        padding: 0;
        color: white;
        background: transparent;
    }

        .features .mud-list-item {
            color: #e6e6e6;
            font-size: 1rem;
            padding: 6px 0;
        }

            .features .mud-list-item::before {
                content: "•";
                color: #D4A017;
                margin-right: 10px;
                font-size: 1.1rem;
            }

    
    @@media (max-width: 992px) {
        .cinema-container {
            padding: 40px;
            gap: 30px;
        }

        .cinema-image {
            height: 400px;
        }

        .c1 {
            font-size: 1.6rem;
        }
    }

    @@media (max-width: 600px) {
        .cinema-container {
            flex-direction: column;
            padding: 20px;
            gap: 20px;
        }

        .cinema-image {
            height: 260px;
            min-width: 100%;
        }

        .cinema-content {
            min-width: 100%;
        }

        .c1 {
            font-size: 1.4rem;
        }

        .para,
        .para2 {
            font-size: 0.9rem;
        }
    }
</style>

@code {
    [Parameter]
    public string image { get; set; } = string.Empty;
    [Parameter]
    public string cinema { get; set; } = string.Empty;
    [Parameter]
    public string paragraph1 { get; set; } = string.Empty;
    [Parameter]
    public string paragraph2 { get; set; } = string.Empty;

    [Parameter]
    public string list1 { get; set; } = string.Empty;

    [Parameter]
    public string list2 { get; set; } = string.Empty;

    [Parameter]
    public string list3 { get; set; } = string.Empty;
}