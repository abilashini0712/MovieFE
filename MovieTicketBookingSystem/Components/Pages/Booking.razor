     *@




@page "/booking/{RegisterId:int}"

@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using System.Globalization

@inject HttpClient Http
@inject NavigationManager Navigation

@attribute [Authorize]

<div class="login-wrapper">
    <MudPaper Class="booking-card">

        <MudForm @ref="form" @bind-IsValid="isValid">

            <MudText Class="head">
                Book Ticket
            </MudText>

           
            <div class="booking-field">
                <MudTextField T="string"
                              Label="Movie Name"
                              Value="@MovieName"
                              ValueChanged="@OnMovieNameChanged"
                              Variant="Variant.Outlined"
                              Required="true" />
            </div>

        
            <div class="booking-field">
                <MudDatePicker Label="Date"
                               Date="@Date"
                               DateChanged="@OnDateChanged"
                               Variant="Variant.Outlined"
                               Required="true" />
            </div>

           
            <div class="booking-field">
                <MudSelect T="string"
                           Label="Time"
                           Value="@Time"
                           ValueChanged="@OnTimeChanged"
                           Variant="Variant.Outlined"
                           Required="true">

                    <MudSelectItem T="string"
                                   Value="@("morning")">
                        10.30 am Morning
                    </MudSelectItem>

                    <MudSelectItem T="string"
                                   Value="@("afternoon")">
                        2.00 pm Afternoon
                    </MudSelectItem>

                    <MudSelectItem T="string"
                                   Value="@("evening")">
                        06.30 pm Evening
                    </MudSelectItem>

                    <MudSelectItem T="string"
                                   Value="@("night")">
                        09.30 pm Night
                    </MudSelectItem>
                </MudSelect>
            </div>

           
            <div class="booking-field">
                <MudSelect T="string"
                           Label="Cinemas"
                           Value="@cinemas"
                           ValueChanged="@OnCinemaChanged"
                           Variant="Variant.Outlined"
                           Required="true">

                    <MudSelectItem T="string"
                                   Value="@("C1")">
                        C1
                    </MudSelectItem>

                    <MudSelectItem T="string"
                                   Value="@("C2")">
                        C2
                    </MudSelectItem>

                    <MudSelectItem T="string"
                                   Value="@("C3")">
                        C3
                    </MudSelectItem>
                </MudSelect>
            </div>

           
            <div class="booking-field">
                <MudNumericField T="int"
                                 Label="Number of Tickets"
                                 @bind-Value="Tickets"
                                 Min="1"
                                 Max="30"
                                 Variant="Variant.Outlined"
                                 Required="true" />
            </div>

           
            <MudText Class="seat-heading">
                Select Your Seats
            </MudText>

            <div class="seat-screen">
                SCREEN
            </div>

            @if (isLoadingSeats)
            {
                <div class="seat-message">
                    <MudProgressCircular Indeterminate="true"
                                         Color="Color.Warning"
                                         Size="Size.Medium" />

                    <MudText>Loading seat availability...</MudText>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(seatError))
            {
                <MudAlert Severity="Severity.Error">
                    @seatError
                </MudAlert>
            }
            else if (!availabilityLoaded)
            {
                <MudAlert Severity="Severity.Info">
                    Select a movie, date, time and cinema
                    to view seat availability.
                </MudAlert>
            }
            else
            {
                <div class="seat-grid">
                    @foreach (var seat in allSeats)
                    {
                        var isReserved = reservedSeats.Contains(seat);
                        var isSelected = selectedSeats.Contains(seat);

                        <MudButton @key="seat"
                                   Class="@GetSeatClass(seat)"
                                   Variant="Variant.Filled"
                                   Size="Size.Small"
                                   Disabled="@isReserved"
                                   OnClick="@(() => ToggleSeat(seat))">

                            @seat

                        </MudButton>
                    }
                </div>
            }

           
            <div class="seat-legend">
                <span>
                    <i class="seat-box selected"></i>
                    Selected
                </span>

                <span>
                    <i class="seat-box available"></i>
                    Available
                </span>

                <span>
                    <i class="seat-box reserved"></i>
                    Reserved
                </span>
            </div>

            <MudText Class="selected-seat-info">
                Selected Seats:
                @(selectedSeats.Count == 0
                    ? "None"
                    : string.Join(", ", selectedSeats.OrderBy(s => s)))
            </MudText>

            <MudText Class="selected-seat-info">
                Tickets Selected: @selectedSeats.Count / @Tickets
            </MudText>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <MudAlert Severity="Severity.Error"
                          Class="mt-3">
                    @errorMessage
                </MudAlert>
            }

            <MudButton OnClick="Payment"
                       Class="pay-btn"
                       FullWidth="true"
                       Disabled="@(
                       isProcessing ||
                       isLoadingSeats ||
                       !availabilityLoaded)">

                @if (isProcessing)
                {
                    <MudProgressCircular Indeterminate="true"
                                         Size="Size.Small"
                                         Class="mr-2" />
                    
                }
                else
                {
                    <span>Process To Payment</span>
                }

            </MudButton>

        </MudForm>

    </MudPaper>
</div>



@code {
    private MudForm? form;
    private bool isValid;


    public DateTime? Date { get; set; } = DateTime.Today;

    public string Time { get; set; } = string.Empty;

    public string cinemas { get; set; } = string.Empty;

    public int Tickets { get; set; }

    public string Seats { get; set; } = string.Empty;

    [Parameter]
    public int RegisterId { get; set; }

    [SupplyParameterFromQuery(Name = "movieName")]
    public string MovieName { get; set; } = string.Empty;

    
    private readonly List<string> allSeats = Enumerable
        .Range(1, 10)
        .SelectMany(row => Enumerable.Range(1, 10)
            .Select(number =>
                $"{(char)('A' + row - 1)}{number}"))
        .ToList();

    private HashSet<string> reservedSeats = new(
        StringComparer.OrdinalIgnoreCase);

    private HashSet<string> selectedSeats = new(
        StringComparer.OrdinalIgnoreCase);

    private bool isLoadingSeats;
    private bool availabilityLoaded;
    private bool isProcessing;

    private string seatError = string.Empty;
    private string errorMessage = string.Empty;

  
    private string GetSeatClass(string seat)
    {
        if (reservedSeats.Contains(seat))
        {
            return "seat-button reserved-seat";
        }

        if (selectedSeats.Contains(seat))
        {
            return "seat-button selected-seat";
        }

        return "seat-button available-seat";
    }

    private void ToggleSeat(string seat)
    {
        if (!availabilityLoaded ||
            isLoadingSeats ||
            reservedSeats.Contains(seat))
        {
            return;
        }

        errorMessage = string.Empty;

        if (selectedSeats.Contains(seat))
        {
            selectedSeats.Remove(seat);
        }
        else
        {
            selectedSeats.Add(seat);
        }
    }

  
    private async Task LoadReservedSeats()
    {
        selectedSeats.Clear();
        reservedSeats.Clear();

        availabilityLoaded = false;
        seatError = string.Empty;
        errorMessage = string.Empty;

        if (Date == null ||
            string.IsNullOrWhiteSpace(Time) ||
            string.IsNullOrWhiteSpace(cinemas) ||
            string.IsNullOrWhiteSpace(MovieName))
        {
            return;
        }

        isLoadingSeats = true;

        try
        {
            var date = Date.Value.ToString(
                "yyyy-MM-dd",
                CultureInfo.InvariantCulture);

            var url =
                "https://localhost:7218/api/Booking/available-seats" +
                $"?date={date}" +
                $"&time={Uri.EscapeDataString(Time)}" +
                $"&cinema={Uri.EscapeDataString(cinemas)}" +
                $"&movieName={Uri.EscapeDataString(MovieName.Trim())}";

            using var response = await Http.GetAsync(url);

            if (!response.IsSuccessStatusCode)
            {
                seatError =
                    "Could not load seat availability. Please try again.";

                return;
            }

            var result = await response.Content
                .ReadFromJsonAsync<List<string>>();

            reservedSeats = new HashSet<string>(
                result ?? new List<string>(),
                StringComparer.OrdinalIgnoreCase);

            availabilityLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Error loading reserved seats: {ex.Message}");

            seatError =
                "Could not connect to the booking server. " +
                "Please try again.";
        }
        finally
        {
            isLoadingSeats = false;
        }
    }

 
    private async Task OnDateChanged(DateTime? value)
    {
        Date = value;
        await LoadReservedSeats();
    }

    private async Task OnTimeChanged(string value)
    {
        Time = value;
        await LoadReservedSeats();
    }

    private async Task OnCinemaChanged(string value)
    {
        cinemas = value;
        await LoadReservedSeats();
    }

    private async Task OnMovieNameChanged(string value)
    {
        MovieName = value;
        await LoadReservedSeats();
    }

    private async Task Payment()
    {
        if (form == null || isProcessing)
        {
            return;
        }

        if (isLoadingSeats || !availabilityLoaded)
        {
            errorMessage =
                "Please load seat availability before continuing.";
            return;
        }

        try
        {
            isProcessing = true;
            errorMessage = string.Empty;

            await form.Validate();

            if (!form.IsValid)
            {
                return;
            }

            if (Date == null)
            {
                errorMessage = "Please select a booking date.";
                return;
            }

            if (Tickets <= 0)
            {
                errorMessage =
                    "Number of tickets must be greater than zero.";
                return;
            }

            if (selectedSeats.Count != Tickets)
            {
                errorMessage =
                    "The number of selected seats must equal " +
                    "the number of tickets.";
                return;
            }

            if (selectedSeats.Any(
                seat => reservedSeats.Contains(seat)))
            {
                errorMessage =
                    "One or more selected seats are already reserved.";
                return;
            }

            Seats = string.Join(
                ",",
                selectedSeats.OrderBy(s => s));

            var bookingData = new
            {
                Seats = Seats,
                Time = Time,
                Cinemas = cinemas,
                Date = Date.Value.ToString(
                    "yyyy-MM-dd",
                    CultureInfo.InvariantCulture),
                Tickets = Tickets,
                RegisterId = RegisterId,
                MovieName = MovieName.Trim()
            };

            using var response = await Http.PostAsJsonAsync(
                "https://localhost:7218/api/Booking",
                bookingData);

            if (response.IsSuccessStatusCode)
            {
                var booking = await response.Content
                    .ReadFromJsonAsync<BookingResponse>();

                if (booking != null && booking.Id > 0)
                {
                    Navigation.NavigateTo(
                        $"/payment/{booking.Id}");
                }
                else
                {
                    errorMessage =
                        "Booking saved, but no valid booking ID was returned.";
                }
            }
            else if ((int)response.StatusCode == 409)
            {
                errorMessage =
                    "Some seats were just booked by another user. " +
                    "Please select your seats again.";

                await LoadReservedSeats();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();

                Console.WriteLine(
                    $"Booking failed: {(int)response.StatusCode} - {error}");

                errorMessage =
                    "Booking failed. Please check your details and try again.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Error saving booking: {ex.Message}");

            errorMessage =
                "An error occurred while processing your booking.";
        }
        finally
        {
            isProcessing = false;
        }
    }

    public class BookingResponse
    {
        public int Id { get; set; }
    }
}


