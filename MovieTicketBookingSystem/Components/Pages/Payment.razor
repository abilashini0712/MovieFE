@page "/payment/{BookingId:int}"

@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization

@inject HttpClient Http
@inject NavigationManager Navigation

@attribute [Authorize]



<div class="payment-wrapper">

    <MudPaper Class="payment-card" Elevation="8">

        <div class="payment-icon">
            <MudIcon Icon="@Icons.Material.Filled.Lock"
                     Size="Size.Large" />
        </div>

        <MudText Typo="Typo.h5" Class="payment-title">
            Secure Payment
        </MudText>

        <MudText Class="payment-subtitle">
            Complete your booking with confidence.
        </MudText>

        <MudDivider Class="payment-divider" />

        <div class="payment-info">
            <MudIcon Icon="@Icons.Material.Filled.Security"
                     Class="security-icon" />

            <MudText Class="payment-description">
                Your card details will be entered securely
                on Stripe Checkout. Your payment information
                is protected.
            </MudText>
        </div>

        <MudButton OnClick="Pay"
                   Disabled="@isLoading"
                   FullWidth="true"
                   Class="pay-btn"
                   Variant="Variant.Filled">

            <MudIcon Icon="@Icons.Material.Filled.Payment"
                     Class="mr-2" />

            @(isLoading ? "Redirecting..." : "Pay with Stripe")

        </MudButton>

        <div class="payment-footer">
            <MudIcon Icon="@Icons.Material.Filled.VerifiedUser"
                     Size="Size.Small" />

            <MudText Class="footer-text">
                Secure checkout powered by Stripe
            </MudText>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">
                @errorMessage
            </MudAlert>
        }

    </MudPaper>

</div>


@code {
    [Parameter]
    public int BookingId { get; set; }

    private bool isLoading;
    private string errorMessage = string.Empty;

    private async Task Pay()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var response = await Http.PostAsJsonAsync(
                "https://localhost:7218/api/Payment/create-checkout-session",
                new { BookingId });

            // if (!response.IsSuccessStatusCode)
            // {
            //     errorMessage =
            //         "Unable to start payment. Please try again.";
            //     return;
            // }

            if (!response.IsSuccessStatusCode)
{
    var error = await response.Content.ReadAsStringAsync();

    errorMessage =
        $"Payment failed ({(int)response.StatusCode}): {error}";

    Console.WriteLine(errorMessage);
    return;
}

            var result = await response.Content
                .ReadFromJsonAsync<CheckoutResponse>();

            if (string.IsNullOrWhiteSpace(result?.checkoutUrl))
            {
                errorMessage = "Stripe did not return a checkout URL.";
                return;
            }

            Navigation.NavigateTo(result.checkoutUrl, forceLoad: true);
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to connect to the payment server.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private sealed class CheckoutResponse
    {
        public string checkoutUrl { get; set; } = string.Empty;
    }
}

<style>
   
.payment-wrapper {
    min-height: calc(100vh - 180px);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 50px 20px;
    background:
        radial-gradient(
            ellipse at center,
            rgba(212, 160, 23, 0.09) 0%,
            #080808 55%,
            #000000 100%
        );
}

/* Payment Card */
.payment-card {
    width: 100%;
    max-width: 460px;
    padding: 40px 38px;
    background: linear-gradient(
        145deg,
        #191919,
        #101010
    ) !important;
    border: 1px solid rgba(212, 160, 23, 0.7);
    border-radius: 16px;
    box-shadow:
        0 15px 45px rgba(0, 0, 0, 0.7),
        0 0 25px rgba(212, 160, 23, 0.12);
    text-align: center;
}

/* Lock Icon */
.payment-icon {
    width: 65px;
    height: 65px;
    margin: 0 auto 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(212, 160, 23, 0.12);
    border: 1px solid rgba(212, 160, 23, 0.4);
    border-radius: 50%;
    color: #D4A017;
}

/* Heading */
.payment-title {
    color: #D4A017;
    font-size: 1.7rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 10px;
}

/* Subtitle */
.payment-subtitle {
    color: #bdbdbd;
    font-size: 0.95rem;
    margin-bottom: 25px;
}

/* Divider */
.payment-divider {
    background-color: rgba(212, 160, 23, 0.3);
    margin-bottom: 25px;
}

/* Payment Information */
.payment-info {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    text-align: left;
    padding: 18px;
    margin-bottom: 25px;
    background-color: rgba(255, 255, 255, 0.035);
    border: 1px solid #333;
    border-radius: 10px;
}

.security-icon {
    color: #D4A017;
    font-size: 25px;
    margin-top: 2px;
}

.payment-description {
    color: #c4c4c4;
    font-size: 0.9rem;
    line-height: 1.7;
}

/* Pay Button */
.pay-btn {
    min-height: 50px;
    background: linear-gradient(
        90deg,
        #D4A017,
        #F2C94C
    ) !important;
    color: #000 !important;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.8px;
    border-radius: 8px;
    box-shadow: 0 5px 15px rgba(212, 160, 23, 0.2);
    transition: all 0.25s ease;
}

.pay-btn:hover {
    background: #f5c542 !important;
    box-shadow: 0 7px 22px rgba(212, 160, 23, 0.4);
    transform: translateY(-2px);
}

.pay-btn:disabled {
    opacity: 0.6;
}

/* Secure Footer */
.payment-footer {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 25px;
    color: #D4A017;
}

.footer-text {
    color: #999;
    font-size: 0.8rem;
}

/* Responsive */
@@media (max-width: 600px) {
    .payment-wrapper {
        min-height: calc(100vh - 150px);
        padding: 30px 15px;
    }

    .payment-card {
        padding: 30px 22px;
        max-width: 100%;
    }

    .payment-title {
        font-size: 1.4rem;
    }
}

@@media (max-width: 400px) {
    .payment-card {
        padding: 25px 18px;
    }

    .payment-icon {
        width: 55px;
        height: 55px;
    }
}

</style>

