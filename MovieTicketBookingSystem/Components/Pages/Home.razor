@page "/"

<MudContainer Class="page-wrapper" MaxWidth="MaxWidth.False">

    <MudStack Row="true" Class="hero-card" AlignItems="AlignItems.Start" Spacing="0">

        <MudImage Src="images/dragon.jpg" Class="movie" ObjectFit="ObjectFit.Cover" />

        <MudStack Class="details" Spacing="0">

            <MudText Typo="Typo.h1" Class="movie-title">How to Train Your Dragon</MudText>

            <MudPaper Class="movie-desc" Elevation="0">
                <MudText>
                    On the rugged isle of Berk, where Vikings and dragons have been bitter enemies for generations,
                    Hiccup stands apart, defying centuries of tradition when he befriends Toothless, a feared Night
                    Fury dragon. Their unlikely bond reveals the true nature of dragons, challenging the very
                    foundations of Viking society.
                </MudText>
            </MudPaper>

            <MudPaper Class="line" Elevation="0">
                <MudText>Now showing at CINE WORLD MULTIPLEX - C2</MudText>
            </MudPaper>

        </MudStack>

    </MudStack>

</MudContainer>


<MudContainer Class="now-showing-wrapper" MaxWidth="MaxWidth.False">
    <MudPaper Class="section-header" Elevation="0">
        <MudText Typo="Typo.h5" Class="section-title">Now Showing</MudText>
    </MudPaper>

    <div class="movie-grid">
        @foreach (var movie in Movies)
        {
            <MudPaper Class="grid-card" Elevation="0">
                <MudImage Src="@movie.Poster" Class="poster" ObjectFit="ObjectFit.Cover" />
                <div class="movie-info">
                    <MudText Class="movie-name">@movie.Title</MudText>
                    <MudText Class="movie-meta">@movie.Year &bull; @movie.Duration</MudText>
                </div>
            </MudPaper>
        }
    </div>
</MudContainer>


<style>

    .page-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 90vh;
        background-color: black;
    }

    .hero-card {
        gap: 50px;
        padding: 60px;
    }

    .movie {
        width: 250px;
        height: 400px;
        box-shadow: 0 0 15px goldenrod;
        flex-shrink: 0;
        border-radius: 4px;
    }

    .details {
        gap: 20px;
        width: 580px;
        color: white;
        font-family: 'Times New Roman', Times, serif;
        margin-top: 40px;
        margin-left: 40px;
    }

    .movie-title {
        margin: 0;
        font-size: 2rem;
        color: white;
    }

    .movie-desc {
        border: 1px solid goldenrod;
        box-shadow: 0 0 5px goldenrod;
        padding: 15px 20px;
        line-height: 1.5;
        background-color: transparent;
        color: white;
    }

    .line {
        width: 100%;
        color: white;
        background-color: #151615;
        box-shadow: 0 0 5px goldenrod;
        padding: 15px;
        box-sizing: border-box;
        font-weight: bold;
    }


    .now-showing-wrapper {
        background-color: black;
        padding: 30px 60px;
    }

    .section-header {
        border: 1px solid goldenrod;
        background-color: black;
        padding: 20px 25px;
        margin-bottom: 30px;
    }

    .section-title {
        color: white;
        font-weight: bold;
    }

    .movie-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 30px;
    }

    @@media (max-width: 900px) {
        .movie-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 500px) {
        .movie-grid {
            grid-template-columns: 1fr;
        }
    }

    .grid-card {
        background-color: #0d0d0d;
        border-radius: 4px;
        overflow: hidden;
    }

    .poster {
        width: 100%;
        height: 420px;
        display: block;
    }

    .movie-info {
        padding: 12px 15px 18px;
    }

    .movie-name {
        color: goldenrod;
        font-family: 'Times New Roman', Times, serif;
        font-weight: bold;
        font-size: 1.1rem;
    }

    .movie-meta {
        color: #bbbbbb;
        font-size: 0.85rem;
        margin-top: 4px;
    }
</style>

@code {
    private List<Movie> Movies = new()
    {
        new Movie { Title = "3BHK", Poster = "images/3bhk.jpg", Year = "2025", Duration = "2h 5m" },
        new Movie { Title = "Avatar Fire And ASH", Poster = "images/avatar.jpg", Year = "2025", Duration = "2h 5m" },
        new Movie { Title = "How to Train Your Dragon", Poster = "images/dragon.jpg", Year = "2025", Duration = "2h 5m" },
        new Movie { Title = "F1", Poster = "images/f1.jpg", Year = "2025", Duration = "2h 5m" },
    };

    private class Movie
    {
        public string Title { get; set; } = "";
        public string Poster { get; set; } = "";
        public string Year { get; set; } = "";
        public string Duration { get; set; } = "";
    }
}

