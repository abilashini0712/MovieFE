@page "/ticket{BookingId:int}"

<div class="ticket-wrapper">
<MudPaper >

    <MudCard Class="ticket-container">
        <div class="ticket-div">
     
        <MudText>Date:@Date </MudText>
        <MudText>Time:@Time </MudText>
        <MudText>Cinemas:@Cinemas </MudText>
        <MudText>Seats:@Seats  </MudText>
        </div>

        <div class="message">
            <MudText> Enjoy your movie   </MudText>
                <MudText> Thank you for booking with us! </MudText>
        </div>

    </MudCard>

</MudPaper>

</div>

<style>

    .ticket-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 90vh;
        background-color: #000000;
        padding: 20px;
    }


    .ticket-container{
        width: 100%;
        max-width: 420px;
        background-color: #121212 !important;
        border: 1px solid #D4A017;
        border-radius: 10px;
        padding: 40px 30px;
        box-shadow: 0 0 20px rgba(212, 160, 23, 0.15);
    }

   .ticket-div{
        color: goldenrod !important;
   }

   .message{
       color:white !important ;
       align-items: center;
        margin-top: 25px;
        border-top: 1px solid #333;
        padding-top: 20px;
   }

</style>
@code {

    public int Id { get; set; }
    public DateTime? Date { get; set; }
    public string Time { get; set; }
    public string Cinemas { get; set; }
    public string Seats { get; set; }
    public int BookingId { get; set; }


}
